# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
# Local development default. For Atlas, use:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/jaffna_mobile_zone?retryWrites=true&w=majority
# NOTE: special characters in the password must be URL-encoded (e.g. "@" -> "%40").
MONGODB_URI=mongodb+srv://jaffna_mobile_zone:Jaffna%40123@jaffna-mobile-cluster.3lhzpwz.mongodb.net/jaffna_mobile_zone?retryWrites=true&w=majority

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-please
JWT_REFRESH_SECRET=change-me-refresh-secret-please
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Cookies
COOKIE_SECURE=false

# Email (optional, used for verify-email / forgot-password tokens)
EMAIL_FROM=noreply@jaffnamobilezone.lk

# Admin account (auto-created/repaired on server start). Set SEED_ADMIN=false to disable.
SEED_ADMIN=true
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@jaffnamobilezone.lk
# Set ADMIN_PASSWORD only to force-reset the admin password on the next boot.
# ADMIN_PASSWORD=Admin@1234

# AI provider (openai-compatible). Leave DISABLE_AI=true to use grounded rule-based AI.
AI_PROVIDER=openai
AI_API_KEY=your-openai-api-key-here
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=600
DISABLE_AI=false
